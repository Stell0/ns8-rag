#!/bin/bash

set -Eeuo pipefail

report_status() {
	for unit in rag.service rag-sync.timer rag-maintenance.timer; do
		systemctl --user status "${unit}" --no-pager || true
	done
}

trap report_status ERR

systemctl --user daemon-reload
systemctl --user reset-failed rag.service rag-sync.timer rag-maintenance.timer || true
systemctl --user enable --now rag.service rag-sync.timer rag-maintenance.timer
systemctl --user restart rag.service

trap - ERR
