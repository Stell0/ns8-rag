#!/usr/bin/env python3

#
# Enqueue a sync job for the worker by appending to jobs.json
# and updating sync-status.json.
#

import json
import os
import secrets
import sys
from datetime import datetime, timezone
from pathlib import Path


SUPPORTED_JOB_TYPES = ("sync_source", "sync_all", "rebuild_acl", "rebuild_vectors", "delete_source", "maintenance")


def utcnow():
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def write_json(path, payload):
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")


payload = sys.stdin.read().strip()
request = json.loads(payload) if payload else {}
job_type = str(request.get("job_type", "sync_all"))
if job_type not in SUPPORTED_JOB_TYPES:
    raise SystemExit(f"Unsupported job_type: {job_type}")

state_dir = Path(os.environ["AGENT_STATE_DIR"])
jobs_file = state_dir / "jobs.json"
status_file = state_dir / "sync-status.json"

jobs = json.loads(jobs_file.read_text()) if jobs_file.exists() else {"jobs": []}
status = json.loads(status_file.read_text()) if status_file.exists() else {}

now = utcnow()
job = {
    "id": f"job_{secrets.token_hex(8)}",
    "job_type": job_type,
    "status": "queued",
    "created_at": now,
    "started_at": None,
    "finished_at": None,
    "error": None,
}
jobs.setdefault("jobs", []).append(job)
write_json(jobs_file, jobs)

status.update({"status": "queued", "queued_at": now, "current_job_id": job["id"], "last_error": None})
status.setdefault("last_started_at", None)
status.setdefault("last_finished_at", None)
status.setdefault("last_successful_sync_at", None)
write_json(status_file, status)

json.dump(job, sys.stdout)
