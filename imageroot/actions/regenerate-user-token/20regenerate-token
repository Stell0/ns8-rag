#!/usr/bin/env python3

#
# Revoke the existing RAG token for one principal and issue a new one.
#

import hashlib
import hmac
import json
import os
import secrets
import sys
from datetime import datetime, timezone
from pathlib import Path

import agent


def utcnow():
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def write_json(path, payload):
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    path.chmod(0o600)


request = json.load(sys.stdin)
principal_id = str(request.get("principal_id", "")).strip()
if not principal_id:
    raise SystemExit("Missing required field: principal_id")

state_dir = Path(os.environ["AGENT_STATE_DIR"])
users_file = state_dir / "tokens" / "users.json"
hashes_file = state_dir / "tokens" / "hashes.json"

clear_data = json.loads(users_file.read_text()) if users_file.exists() else {"tokens": []}
hash_data = json.loads(hashes_file.read_text()) if hashes_file.exists() else {"tokens": []}

existing = next((e for e in clear_data.get("tokens", []) if e.get("principal_id") == principal_id), None)
if existing is None:
    raise SystemExit(f"Unknown principal_id: {principal_id}")
username = existing["username"]

secrets_map = agent.read_envfile(str(state_dir / "secrets.env"))
pepper = secrets_map["RAG_TOKEN_PEPPER"]

token_id = secrets.token_hex(12)
raw_secret = secrets.token_hex(24)
clear_token = f"rag_ut_{token_id}_{raw_secret}"
token_hash = hmac.new(pepper.encode(), f"{token_id}.{raw_secret}".encode(), hashlib.sha256).hexdigest()
now = utcnow()

next_hash = []
for entry in hash_data.get("tokens", []):
    if entry.get("principal_id") == principal_id and entry.get("enabled"):
        next_hash.append({**entry, "enabled": False, "revoked_at": now})
    else:
        next_hash.append(entry)
next_hash.append({
    "principal_id": principal_id,
    "username": username,
    "token_id": token_id,
    "token_hash": token_hash,
    "enabled": True,
    "generated_at": now,
    "revoked_at": None,
    "last_used_at": None,
})

next_clear = [e for e in clear_data.get("tokens", []) if e.get("principal_id") != principal_id]
next_clear.append({
    "principal_id": principal_id,
    "username": username,
    "token_id": token_id,
    "token": clear_token,
})

write_json(users_file, {"generated_at": now, "tokens": sorted(next_clear, key=lambda e: e["username"])})
write_json(hashes_file, {"updated_at": now, "tokens": next_hash})

tcp_port = os.environ.get("TCP_PORT", "20073")
node_id = os.environ.get("NODE_ID", "node1")

json.dump({
    "principal_id": principal_id,
    "token": clear_token,
    "api_url": f"http://127.0.0.1:{tcp_port}/api",
    "internal_url": f"http://127.0.0.1:{tcp_port}/api",
    "same_node_only": True,
    "node_id": node_id,
}, sys.stdout)
