#!/usr/bin/env python3

#
# Return current ns8-rag configuration, discovered source instances,
# token visibility (without clear tokens), and the latest runtime status.
#

import json
import os
import subprocess
import sys
from pathlib import Path

import agent


SUPPORTED_SOURCES = ("nextcloud", "samba", "webtop", "nethvoice", "mattermost")


def to_bool(value, default=False):
    if value is None:
        return default
    return str(value).strip().lower() in {"1", "true", "yes", "on"}


def env_int(env, key, default):
    try:
        return int(env.get(key, default))
    except (TypeError, ValueError):
        return default


def env_json(env, key, default):
    raw = env.get(key)
    if not raw:
        return default
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return default


def discover_instances(configured):
    discovered = {name: [] for name in SUPPORTED_SOURCES}
    try:
        result = subprocess.run(
            ["api-cli", "run", "list-modules"],
            check=True, capture_output=True, text=True,
        )
        modules = json.loads(result.stdout or "[]")
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError):
        modules = []

    for app in modules if isinstance(modules, list) else []:
        if not isinstance(app, dict):
            continue
        name = str(app.get("id", "")).strip()
        if name not in discovered:
            continue
        for inst in app.get("installed") or []:
            mid = str((inst or {}).get("id", "")).strip()
            if mid:
                discovered[name].append(mid)
        discovered[name] = sorted(dict.fromkeys(discovered[name]))

    for name, current in configured.items():
        if current and current not in discovered[name]:
            discovered[name].append(current)
    return discovered


state_dir = Path(os.environ.get("AGENT_STATE_DIR", os.getcwd()))
env = agent.read_envfile(str(state_dir / "environment")) if (state_dir / "environment").exists() else {}

users = env_json(env, "RAG_USERS_JSON", [])

sources = {
    "nextcloud": {
        "enabled": to_bool(env.get("NEXTCLOUD_ENABLED")),
        "instance": env.get("NEXTCLOUD_INSTANCE", ""),
        "mode": env.get("NEXTCLOUD_MODE", "personal_files"),
        "base_url": env.get("NEXTCLOUD_BASE_URL", ""),
        "tls_verify": to_bool(env.get("NEXTCLOUD_TLS_VERIFY"), True),
        "users": env_json(env, "NEXTCLOUD_USERS_JSON", []),
    },
    "samba": {
        "enabled": to_bool(env.get("SAMBA_ENABLED")),
        "instance": env.get("SAMBA_INSTANCE", ""),
        "shares": env_json(env, "SAMBA_SHARES", []),
        "share_group_map": env_json(env, "SAMBA_SHARE_GROUP_MAP_JSON", {}),
    },
    "webtop": {
        "enabled": to_bool(env.get("WEBTOP_ENABLED")),
        "instance": env.get("WEBTOP_INSTANCE", ""),
        "contacts": to_bool(env.get("WEBTOP_INGEST_CONTACTS"), True),
        "calendars": to_bool(env.get("WEBTOP_INGEST_CALENDARS"), True),
        "mail": False,
    },
    "nethvoice": {
        "enabled": to_bool(env.get("NETHVOICE_ENABLED")),
        "instance": env.get("NETHVOICE_INSTANCE", ""),
        "phonebook": to_bool(env.get("NETHVOICE_INGEST_PHONEBOOK"), True),
        "transcriptions": to_bool(env.get("NETHVOICE_INGEST_TRANSCRIPTIONS"), True),
        "recordings": False,
    },
    "mattermost": {
        "enabled": to_bool(env.get("MATTERMOST_ENABLED")),
        "instance": env.get("MATTERMOST_INSTANCE", ""),
        "posts": to_bool(env.get("MATTERMOST_INGEST_POSTS"), True),
        "files": to_bool(env.get("MATTERMOST_INGEST_FILES"), True),
        "direct_messages": False,
    },
}

hashes_file = state_dir / "tokens" / "hashes.json"
hash_data = json.loads(hashes_file.read_text()) if hashes_file.exists() else {"tokens": []}
hash_by_principal = {e["principal_id"]: e for e in hash_data.get("tokens", [])}

users_file = state_dir / "tokens" / "users.json"
clear_data = json.loads(users_file.read_text()) if users_file.exists() else {"tokens": []}
clear_principals = {e["principal_id"] for e in clear_data.get("tokens", [])}

runtime_state_file = state_dir / "runtime-state.json"
runtime_state = json.loads(runtime_state_file.read_text()) if runtime_state_file.exists() else {
    "objects": 0,
    "chunks": 0,
    "errors": 0,
    "index_status": "not_configured",
    "active_collection": None,
    "last_sync_at": None,
}

tcp_port = os.environ.get("TCP_PORT", "20073")
node_id = os.environ.get("NODE_ID", "node1")
module_id = os.environ.get("MODULE_ID", os.environ.get("RAG_MODULE_ID", "rag1"))

output = {
    "configuration": {
        "internal_url": f"http://127.0.0.1:{tcp_port}/api",
        "same_node_only": True,
        "node_id": node_id,
        "instance_id": module_id,
        "sync_interval_minutes": env_int(env, "SYNC_INTERVAL_MINUTES", 30),
        "embedding_provider": env.get("EMBEDDING_PROVIDER", "local"),
        "embedding_model": env.get("EMBEDDING_MODEL", "BAAI/bge-m3"),
        "embedding_dimension": env_int(env, "EMBEDDING_DIMENSION", 1024),
        "max_file_size_mb": env_int(env, "MAX_FILE_SIZE_MB", 100),
        "users": users,
        "sources": sources,
    },
    "available_instances": discover_instances({name: src["instance"] for name, src in sources.items()}),
    "tokens": {
        "generated": bool(clear_data.get("tokens")),
        "token_file": str(users_file),
        "users": [
            {
                "principal_id": u["principal_id"],
                "username": u["username"],
                "has_token": u["principal_id"] in clear_principals,
                "last_used_at": hash_by_principal.get(u["principal_id"], {}).get("last_used_at"),
                "enabled": hash_by_principal.get(u["principal_id"], {}).get("enabled", False),
            }
            for u in users
        ],
    },
    "status": runtime_state,
}

json.dump(output, sys.stdout)
