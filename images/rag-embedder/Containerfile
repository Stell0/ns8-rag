FROM docker.io/library/python:3.12-slim

WORKDIR /app

# CPU-only torch keeps the image small. sentence-transformers pulls transformers + tokenizers.
RUN pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    "torch==2.*" \
 && pip install --no-cache-dir \
    "sentence-transformers==3.*"

COPY src /app/src

ENV PYTHONPATH=/app/src \
    HF_HOME=/state/model-cache \
    TRANSFORMERS_OFFLINE=0 \
    SENTENCE_TRANSFORMERS_HOME=/state/model-cache

CMD ["uvicorn", "embedder.main:app", "--host", "0.0.0.0", "--port", "8090"]