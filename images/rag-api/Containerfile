FROM docker.io/library/python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    psycopg[binary]==3.* \
    qdrant-client==1.* \
    requests

COPY src /app/src

ENV PYTHONPATH=/app/src

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8080"]